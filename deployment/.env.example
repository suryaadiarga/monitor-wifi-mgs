# Salin ke /etc/isp-manager/deploy.env lalu isi secret langsung di server.
# File ini sengaja tidak memuat credential nyata.
APP_NAME="ISP Manager"
APP_DIR=/var/www/isp-manager
SERVER_NAME=isp.example.net
APP_URL=https://isp.example.net
APP_ENV=production
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=isp_manager
DB_USER=isp_manager
DB_PASSWORD=

RADIUS_DB_HOST=127.0.0.1
RADIUS_DB_PORT=3306
RADIUS_DB_NAME=isp_manager_radius
RADIUS_DB_USER=isp_radius
RADIUS_DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Gunakan CIDR/IP, dipisah koma. Jangan gunakan 0.0.0.0/0.
SSH_ALLOW_FROM=
RADIUS_ALLOWED_IPS=192.0.2.10/32
CWMP_ALLOWED_IPS=10.20.0.0/16
WIREGUARD_PORT=51820
ENABLE_WIREGUARD=0
ENABLE_IKEV2=0

# HTTPS hanya dijalankan bila DNS SERVER_NAME sudah menunjuk ke VPS.
ENABLE_HTTPS=0
CERTBOT_EMAIL=admin@example.net

# Seeder production harus idempotent. Demo seeder tidak dijalankan secara default.
RUN_SEEDER=0
SEED_CLASS=DatabaseSeeder

# Versi major yang didukung Ubuntu 24.04 pada fondasi ini.
NODE_MAJOR=22
MONGODB_MAJOR=8.0

# Opsional untuk VPS kecil. Membuat swapfile baru tanpa mengubah swap yang sudah ada.
AUTO_SWAP_MB=0

# Backup terenkripsi. Deploy membuat passphrase acak pada path ini bila belum ada.
BACKUP_ROOT=/var/backups/isp-manager
BACKUP_ENCRYPTION_KEY_FILE=/etc/isp-manager/backup-passphrase
BACKUP_DAILY_RETENTION_DAYS=14
BACKUP_WEEKLY_RETENTION_DAYS=56
BACKUP_MONTHLY_RETENTION_DAYS=365
