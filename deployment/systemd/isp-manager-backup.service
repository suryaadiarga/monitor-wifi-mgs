[Unit]
Description=Encrypted backup for ISP Manager
After=mariadb.service mongod.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/isp-manager/backup.env
ExecStart=/usr/local/sbin/isp-manager-backup --apply
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true

