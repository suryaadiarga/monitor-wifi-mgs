APP_NAME="ISP Terpadu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=isp_terpadu
DB_USERNAME=isp_terpadu
DB_PASSWORD=

RADIUS_DB_DRIVER=
RADIUS_DB_HOST=127.0.0.1
RADIUS_DB_PORT=3306
RADIUS_DB_DATABASE=
RADIUS_DB_USERNAME=
RADIUS_DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MIKROTIK_DRIVER=mock
MIKROTIK_CONNECT_TIMEOUT=5
MIKROTIK_READ_TIMEOUT=8
MIKROTIK_CONNECT_ATTEMPTS=2
MIKROTIK_RETRY_DELAY_SECONDS=1
OLT_DRIVER=mock
DEVICE_DRY_RUN=true
GENIEACS_NBI_URL=http://127.0.0.1:7557
POLL_ROUTER_STATUS_SECONDS=300
POLL_ROUTER_RESOURCES_SECONDS=300
POLL_ROUTER_ACTIVE_SECONDS=180
POLL_ROUTER_NETWORK_SECONDS=600
POLL_ROUTER_CONFIG_SECONDS=1800

DEMO_DATA_ENABLED=false
DEMO_ADMIN_EMAIL=admin@isp.test
DEMO_ADMIN_PASSWORD=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
