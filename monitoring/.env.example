# Salin sebagai monitoring/.env (file tersebut tidak boleh di-commit).
# Wajib diisi dengan password unik sebelum docker compose up.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

GRAFANA_PORT=3002
PROMETHEUS_PORT=9090
LOKI_PORT=3100
PROMETHEUS_RETENTION=30d

# Pin versi setelah diuji pada lingkungan Anda.
PROMETHEUS_VERSION=v3.12.0
GRAFANA_VERSION=13.0.2
LOKI_VERSION=3.7.2
ALLOY_VERSION=v1.16.1
NODE_EXPORTER_VERSION=v1.11.1
SNMP_EXPORTER_VERSION=v0.30.1
